<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-amber-50/20 text-slate-800 min-h-screen flex flex-col font-sans">

  <!-- Navbar -->
  <%- include('../partials/publicNav') %>

  <!-- Breadcrumb -->
  <div class="bg-white border-b border-emerald-100 py-3">
    <div class="max-w-6xl mx-auto px-4 text-xs text-slate-500 flex items-center gap-2">
      <a href="/" class="hover:text-emerald-800">Beranda</a>
      <span>/</span>
      <a href="/katalog" class="hover:text-emerald-800">Katalog Jamu</a>
      <span>/</span>
      <a href="/katalog?kategori=<%= product.kategori_id %>" class="hover:text-emerald-800"><%= product.nama_kategori %></a>
      <span>/</span>
      <span class="text-emerald-950 font-bold truncate max-w-xs"><%= product.nama_produk %></span>
    </div>
  </div>

  <main class="max-w-6xl mx-auto px-4 py-10 flex-1 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Kolom Kiri: Foto, Harga, Order WhatsApp & Asisten AI (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Foto Produk -->
        <div class="relative bg-white rounded-3xl border border-emerald-100 overflow-hidden shadow-xs">
          <img 
            src="<%= product.foto_url %>" 
            alt="<%= product.nama_produk %>"
            class="w-full aspect-4/3 object-cover"
            onerror="this.src='https://images.unsplash.com/photo-1615485290382-441e4d049cb5?auto=format&fit=crop&w=800&q=80'"
          >
          <% if (product.is_unggulan) { %>
            <span class="absolute top-3 left-3 bg-amber-400 text-emerald-950 text-xs font-black px-3 py-1 rounded-lg shadow-xs">
              ⭐ Produk Unggulan
            </span>
          <% } %>
          <span class="absolute bottom-3 right-3 bg-emerald-950/85 text-white text-xs font-semibold px-3 py-1 rounded-lg backdrop-blur-xs">
            <%= product.ukuran %>
          </span>
        </div>

        <!-- Box Pembelian & Kontak Pemesanan -->
        <div class="bg-white p-6 rounded-3xl border border-emerald-100 shadow-xs space-y-4">
          <div class="flex items-baseline justify-between border-b border-slate-100 pb-4">
            <div>
              <span class="text-[11px] text-slate-400 block font-medium">Harga Resmi:</span>
              <span class="text-2xl font-black text-emerald-900"><%= formatRupiah(product.harga) %></span>
            </div>
            <div class="text-right">
              <span class="text-[11px] text-slate-400 block font-medium">Ketersediaan:</span>
              <% if (product.stok <= 0) { %>
                <span class="text-xs font-bold text-rose-600">Habis</span>
              <% } else { %>
                <span class="text-xs font-bold text-emerald-700">Tersedia (<%= product.stok %> porsi/botol)</span>
              <% } %>
            </div>
          </div>

          <!-- Tombol WhatsApp Order -->
          <a 
            href="<%= whatsappUrl %>" 
            target="_blank"
            class="w-full py-3.5 px-4 bg-emerald-700 hover:bg-emerald-800 text-white rounded-2xl font-bold text-xs sm:text-sm transition shadow-md flex items-center justify-center gap-2 cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Pesan Cepat via WhatsApp</span>
          </a>

          <!-- Tombol Tanya Asisten AI Terintegrasi Konteks -->
          <button 
            type="button"
            id="btnAskAI"
            data-slug="<%= product.slug %>"
            data-name="<%= product.nama_produk %>"
            class="w-full py-3 px-4 bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 rounded-2xl font-bold text-xs transition flex items-center justify-center gap-2 cursor-pointer">
            <span>🤖</span>
            <span>Tanya Asisten AI tentang <%= product.nama_produk %></span>
          </button>

          <p class="text-[10px] text-slate-400 text-center leading-tight">
            Pemesanan langsung terhubung ke Bu Wati (Owner Seduh Rimba). Pengiriman sameday / ekspedisi tersedia.
          </p>
        </div>
      </div>

      <!-- Kolom Kanan: Rincian Lengkap Produk (7 Cols) -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Title & Category -->
        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-emerald-100 shadow-xs space-y-3">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full">
              <%= product.nama_kategori %>
            </span>
            <span class="text-xs text-slate-400 font-medium">Ukuran: <%= product.ukuran %></span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-black text-emerald-950 tracking-tight leading-tight">
            <%= product.nama_produk %>
          </h1>

          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed pt-1">
            <%= product.deskripsi %>
          </p>
        </div>

        <!-- Khasiat & Manfaat Tradisional -->
        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-emerald-100 shadow-xs space-y-3">
          <h2 class="text-sm font-bold text-emerald-950 flex items-center gap-2">
            <span>🌱</span> Khasiat & Manfaat Tradisional
          </h2>
          <div class="bg-amber-50/50 border-l-4 border-amber-400 p-4 rounded-r-2xl text-xs sm:text-sm text-slate-700 leading-relaxed">
            <p><%= product.manfaat_tradisional %></p>
          </div>
          <p class="text-[10px] text-slate-400 italic">
            *Catatan: Manfaat disajikan secara tradisional berdasarkan kearifan lokal rempah nusantara.
          </p>
        </div>

        <!-- Komposisi & Profil Rasa -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-white p-6 rounded-3xl border border-emerald-100 shadow-xs space-y-2">
            <h3 class="text-xs font-bold text-emerald-950 flex items-center gap-1.5">
              <span>🌿</span> Komposisi Bahan Alami
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed"><%= product.komposisi %></p>
          </div>

          <div class="bg-white p-6 rounded-3xl border border-emerald-100 shadow-xs space-y-2">
            <h3 class="text-xs font-bold text-emerald-950 flex items-center gap-1.5">
              <span>👅</span> Karakter Rasa
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed"><%= product.rasa %></p>
          </div>
        </div>

        <!-- Saran Penyajian & Petunjuk Penyimpanan -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-white p-6 rounded-3xl border border-emerald-100 shadow-xs space-y-2">
            <h3 class="text-xs font-bold text-emerald-950 flex items-center gap-1.5">
              <span>🍵</span> Cara Penyajian
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed"><%= product.cara_penyajian %></p>
          </div>

          <div class="bg-white p-6 rounded-3xl border border-emerald-100 shadow-xs space-y-2">
            <h3 class="text-xs font-bold text-emerald-950 flex items-center gap-1.5">
              <span>❄️</span> Penyimpanan & Daya Simpan
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              <strong>Penyimpanan:</strong> <%= product.cara_penyimpanan %><br>
              <strong>Masa Simpan:</strong> <%= product.masa_simpan %>
            </p>
          </div>
        </div>

        <!-- Peringatan Konsumsi (Keamanan Konsumsi) -->
        <% if (product.peringatan) { %>
          <div class="bg-rose-50 border border-rose-200 p-5 rounded-3xl shadow-xs space-y-2">
            <h3 class="text-xs font-bold text-rose-900 flex items-center gap-1.5">
              <span>⚠️</span> Peringatan & Keamanan Konsumsi
            </h3>
            <p class="text-xs text-rose-800 leading-relaxed">
              <%= product.peringatan %>
            </p>
            <p class="text-[10px] text-rose-600/80">
              Bila memiliki riwayat maag kronis, alergi rimpang tertentu, sedang hamil, atau dalam perawatan obat dokter, silakan konsultasikan dengan tenaga medis terlebih dahulu.
            </p>
          </div>
        <% } %>

      </div>
    </div>

    <!-- Produk Terkait Kategori Sama -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
      <div class="mt-16 pt-10 border-t border-emerald-100">
        <h2 class="text-lg font-black text-emerald-950 mb-6">Produk Jamu Lainnya di Kategori Ini</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <% relatedProducts.forEach(function(rel) { %>
            <div class="bg-white rounded-2xl border border-emerald-100 overflow-hidden shadow-2xs hover:shadow-md transition flex flex-col group">
              <div class="aspect-4/3 overflow-hidden bg-slate-100">
                <img 
                  src="<%= rel.foto_url %>" 
                  alt="<%= rel.nama_produk %>" 
                  class="w-full h-full object-cover group-hover:scale-105 transition"
                  onerror="this.src='https://images.unsplash.com/photo-1615485290382-441e4d049cb5?auto=format&fit=crop&w=600&q=80'"
                >
              </div>
              <div class="p-4 flex-1 flex flex-col">
                <h4 class="font-bold text-xs text-slate-900 group-hover:text-emerald-800 transition line-clamp-1 mb-1">
                  <%= rel.nama_produk %>
                </h4>
                <p class="text-[11px] text-slate-500 line-clamp-2 mb-3"><%= rel.manfaat_tradisional %></p>
                <div class="mt-auto flex items-center justify-between">
                  <span class="font-black text-xs text-emerald-900"><%= formatRupiah(rel.harga) %></span>
                  <a href="/produk/<%= rel.slug %>" class="px-2.5 py-1 bg-emerald-800 hover:bg-emerald-900 text-white text-[11px] font-bold rounded-lg transition">
                    Lihat &rarr;
                  </a>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>
  </main>

  <!-- Footer & Chatbot -->
  <%- include('../partials/publicFooter') %>
  <%- include('../partials/chatWidget') %>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('btnAskAI');
      if (btn && window.openChatWithProduct) {
        btn.addEventListener('click', () => {
          window.openChatWithProduct(btn.dataset.slug, btn.dataset.name);
        });
      }
    });
  </script>
</body>
</html>
