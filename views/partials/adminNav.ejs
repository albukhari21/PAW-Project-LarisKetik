<!-- Navbar Admin Panel (Mobile-First Bu Wati) -->
<header class="bg-emerald-900 text-white sticky top-0 z-40 shadow-md">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/admin/produk" class="flex items-center gap-2">
        <span class="text-2xl">🌿</span>
        <div>
          <span class="font-extrabold text-base tracking-tight block leading-tight">Seduh Rimba</span>
          <span class="text-[10px] text-amber-300 font-semibold uppercase tracking-wider block">Panel Bu Wati</span>
        </div>
      </a>
    </div>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-1.5 text-xs font-semibold">
      <a href="/admin/produk" class="px-3 py-2 rounded-lg transition <%= currentPath.startsWith('/admin/produk') ? 'bg-emerald-800 text-white shadow-inner' : 'text-emerald-100 hover:bg-emerald-800/60' %>">
        📦 Kelola Produk
      </a>
      <a href="/admin/kategori" class="px-3 py-2 rounded-lg transition <%= currentPath.startsWith('/admin/kategori') ? 'bg-emerald-800 text-white shadow-inner' : 'text-emerald-100 hover:bg-emerald-800/60' %>">
        🏷️ Kategori
      </a>
      <a href="/admin/caption" class="px-3 py-2 rounded-lg transition <%= currentPath.startsWith('/admin/caption') ? 'bg-emerald-800 text-white shadow-inner' : 'text-emerald-100 hover:bg-emerald-800/60' %>">
        ✍️ Generator Caption AI
      </a>
      <a href="/" target="_blank" class="px-3 py-2 text-emerald-200 hover:text-white rounded-lg transition flex items-center gap-1">
        <span>🌐 Toko Publik ↗</span>
      </a>
      <a href="/admin/logout" onclick="return confirm('Yakin ingin keluar dari panel admin?')" class="ml-2 px-3 py-1.5 bg-rose-600/80 hover:bg-rose-600 text-white rounded-lg transition">
        🚪 Keluar
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button onclick="toggleMobileAdminNav()" class="md:hidden p-2 rounded-lg hover:bg-emerald-800 text-emerald-100 cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Nav -->
  <div id="mobileAdminNav" class="hidden md:hidden px-4 pb-4 pt-1 bg-emerald-950 border-t border-emerald-800 text-xs font-semibold space-y-1">
    <a href="/admin/produk" class="block px-3 py-2.5 rounded-lg <%= currentPath.startsWith('/admin/produk') ? 'bg-emerald-800 text-white' : 'text-emerald-100 hover:bg-emerald-900' %>">
      📦 Kelola Produk
    </a>
    <a href="/admin/kategori" class="block px-3 py-2.5 rounded-lg <%= currentPath.startsWith('/admin/kategori') ? 'bg-emerald-800 text-white' : 'text-emerald-100 hover:bg-emerald-900' %>">
      🏷️ Kategori
    </a>
    <a href="/admin/caption" class="block px-3 py-2.5 rounded-lg <%= currentPath.startsWith('/admin/caption') ? 'bg-emerald-800 text-white' : 'text-emerald-100 hover:bg-emerald-900' %>">
      ✍️ Generator Caption AI
    </a>
    <a href="/" target="_blank" class="block px-3 py-2.5 text-amber-300 hover:text-white rounded-lg">
      🌐 Lihat Tampilan Toko Publik ↗
    </a>
    <a href="/admin/logout" onclick="return confirm('Yakin ingin keluar dari panel admin?')" class="block px-3 py-2.5 text-rose-300 hover:text-rose-100 rounded-lg">
      🚪 Keluar dari Sistem
    </a>
  </div>
</header>

<script>
  function toggleMobileAdminNav() {
    const nav = document.getElementById('mobileAdminNav');
    nav.classList.toggle('hidden');
  }
</script>
