<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">

  <!-- Header -->
  <header class="bg-indigo-600 text-white shadow-md sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-3">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">LarisKetik ✍️</h1>
        <p class="text-xs text-indigo-100">Katalog & Manajemen Takarir Promosi UMKM (MySQL Connected)</p>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="bukaModalTambah()" class="bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-semibold py-2 px-3.5 rounded-lg shadow-sm transition flex items-center gap-1.5 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>+ Tambah Produk Baru</span>
        </button>
        <a href="/api/produk" target="_blank" class="text-xs bg-indigo-700 hover:bg-indigo-800 text-white py-2 px-3 rounded-lg border border-indigo-400 transition">
          Test JSON ↗
        </a>
      </div>
    </div>
  </header>

  <!-- Konten Utama -->
  <main class="max-w-6xl mx-auto px-4 py-8 flex-1 w-full">
    
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold mb-2">
          ● Database MySQL Aktif
        </span>
        <h2 class="text-2xl font-extrabold text-slate-900">Katalog Promosi Real-Time</h2>
        <p class="text-slate-600 text-sm mt-1">Data di bawah ini dibaca langsung dari tabel <code>produk</code> di MySQL. Kamu dapat menambah, mengedit, atau menghapus item.</p>
      </div>
      <div class="text-right">
        <span class="text-xs font-semibold text-slate-500">Total Tersimpan:</span>
        <p class="text-2xl font-black text-indigo-600"><%= products.length %> Item</p>
      </div>
    </div>

    <!-- Grid Produk -->
    <% if (products.length === 0) { %>
      <div class="bg-white rounded-xl border border-dashed border-slate-300 p-12 text-center">
        <p class="text-slate-500 text-sm">Belum ada data produk di database MySQL.</p>
        <button onclick="bukaModalTambah()" class="mt-3 text-indigo-600 text-xs font-bold underline">Tambah produk pertama sekarang</button>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% products.forEach(function(item) { %>
          <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 flex flex-col justify-between hover:shadow-md transition">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700">
                  <%= item.target_media %>
                </span>
                <span class="text-xs font-bold text-indigo-600">
                  Rp <%= Number(item.harga).toLocaleString('id-ID') %>
                </span>
              </div>

              <h3 class="text-lg font-bold text-slate-900 mb-1 leading-snug">
                <%= item.nama_produk %>
              </h3>
              <p class="text-xs font-medium text-slate-500 mb-3">
                Pemilik: <%= item.pemilik %>
              </p>

              <div class="mb-3">
                <p class="text-xs text-slate-400 font-medium uppercase tracking-wider mb-1">Keunggulan:</p>
                <p class="text-xs text-slate-600 bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                  <%= item.keunggulan %>
                </p>
              </div>

              <div class="mb-4">
                <p class="text-xs text-slate-400 font-medium uppercase tracking-wider mb-1">Draf Caption Promosi:</p>
                <div id="caption-<%= item.id %>" class="text-xs text-slate-700 bg-amber-50/70 border border-amber-200/60 p-3 rounded-lg leading-relaxed whitespace-pre-line font-mono">
                  <%= item.caption_otomatis %>
                </div>
              </div>
            </div>

            <!-- Tombol Aksi CRUD & Salin -->
            <div class="space-y-2 pt-2 border-t border-slate-100">
              <button onclick="salinTeks('caption-<%= item.id %>', this)" class="w-full bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold text-xs py-2 px-3 rounded-lg flex items-center justify-center gap-1.5 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span>Salin Teks</span>
              </button>

              <div class="grid grid-cols-2 gap-2">
                <button onclick="bukaModalEdit(<%= item.id %>)" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs py-2 px-3 rounded-lg text-center transition">
                  ✏️ Edit
                </button>
                <button onclick="hapusProduk(<%= item.id %>)" class="bg-rose-50 hover:bg-rose-100 text-rose-600 font-medium text-xs py-2 px-3 rounded-lg text-center transition">
                  🗑️ Hapus
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>

  <!-- Modal Form (Untuk Tambah & Edit Produk) -->
  <div id="modalForm" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-4 border-b pb-3">
        <h3 id="modalTitle" class="text-lg font-bold text-slate-900">Tambah Produk Baru</h3>
        <button onclick="tutupModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
      </div>

      <form id="productForm" onsubmit="simpanData(event)" class="space-y-3.5">
        <input type="hidden" id="formId">

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Produk</label>
          <input type="text" id="formNamaProduk" required placeholder="Contoh: Paket Brownies Fudgy" class="w-full px-3 py-2 text-xs border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Pemilik / Toko</label>
            <input type="text" id="formPemilik" required placeholder="Contoh: Asep Kopling" class="w-full px-3 py-2 text-xs border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Target Media</label>
            <select id="formTargetMedia" class="w-full px-3 py-2 text-xs border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
              <option value="Status WhatsApp">Status WhatsApp</option>
              <option value="Instagram / Facebook">Instagram / Facebook</option>
              <option value="TikTok Shop">TikTok Shop</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Harga (Rp)</label>
          <input type="number" id="formHarga" required placeholder="15000" class="w-full px-3 py-2 text-xs border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Keunggulan Produk</label>
          <textarea id="formKeunggulan" rows="2" required placeholder="Tuliskan keunggulan spesifik produk..." class="w-full px-3 py-2 text-xs border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none"></textarea>
        </div>

        <div>
          <div class="flex justify-between items-center mb-1">
            <label class="block text-xs font-semibold text-slate-700">Draf Caption Otomatis</label>
            <button type="button" id="btnRacikAI" onclick="racikCaptionAI()" class="text-[11px] font-semibold text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-2.5 py-0.5 rounded-md transition flex items-center gap-1 cursor-pointer">
              <span>✨ Racik Caption via AI</span>
            </button>
          </div>
          <textarea id="formCaption" rows="3" required placeholder="Tuliskan draf kata-kata promosi atau klik 'Racik Caption via AI'..." class="w-full px-3 py-2 text-xs border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none"></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-3 border-t">
          <button type="button" onclick="tutupModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium rounded-lg">Batal</button>
          <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg shadow-sm">Simpan Data</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Floating Action Button: AI Assistant -->
  <div class="fixed bottom-6 right-6 z-40">
    <button id="btnToggleChat" onclick="toggleChatWindow()" class="bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white rounded-full py-3 px-4 shadow-xl hover:shadow-2xl transition-all duration-200 flex items-center gap-2.5 cursor-pointer group">
      <span class="text-xl">🤖</span>
      <span class="text-xs font-bold pr-1 hidden sm:inline">Tanya LarisBot AI</span>
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
      </span>
    </button>
  </div>

  <!-- Window Chatbot AI Assistant -->
  <div id="chatWindow" class="fixed bottom-20 right-4 sm:right-6 w-[92vw] sm:w-[420px] h-[530px] max-h-[82vh] bg-white rounded-2xl shadow-2xl border border-slate-200 z-50 flex flex-col overflow-hidden hidden transition-all duration-300">
    <!-- Chat Header -->
    <div class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white p-4 flex items-center justify-between shadow-xs">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center text-lg shadow-inner">🤖</div>
        <div>
          <h4 class="font-bold text-sm tracking-wide leading-tight">LarisBot (AI Assistant)</h4>
          <p class="text-[11px] text-indigo-100 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span> Online &bull; Terhubung Konteks MySQL
          </p>
        </div>
      </div>
      <button onclick="toggleChatWindow()" class="text-white/80 hover:text-white text-2xl font-bold leading-none p-1 cursor-pointer">&times;</button>
    </div>

    <!-- Chat Messages Container -->
    <div id="chatMessages" class="flex-1 p-4 overflow-y-auto space-y-3 bg-slate-50/70 text-xs">
      <!-- Pesan Sambutan Bot -->
      <div class="flex items-start gap-2">
        <div class="w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-xs shrink-0">🤖</div>
        <div class="bg-white border border-slate-200 p-3 rounded-2xl rounded-tl-none shadow-xs text-slate-700 leading-relaxed max-w-[85%]">
          Halo! Saya <strong>LarisBot</strong> ✍️, Asisten AI resmi LarisKetik. Saya siap membantu info katalog produk, fitur aplikasi, atau memberikan rekomendasi ide caption promosi toko Anda. Ada yang bisa saya bantu?
        </div>
      </div>

      <!-- Quick Prompt Pills -->
      <div id="quickPills" class="pt-1 flex flex-wrap gap-1.5 pl-9">
        <button onclick="kirimPesanQuick('Apa saja produk yang tersedia di katalog?')" class="text-[11px] bg-indigo-50 hover:bg-indigo-100 text-indigo-700 px-2.5 py-1 rounded-full border border-indigo-200 transition cursor-pointer">
          💡 Produk apa saja yang ada?
        </button>
        <button onclick="kirimPesanQuick('Rekomendasi ide promo untuk katering Asep Kopling')" class="text-[11px] bg-indigo-50 hover:bg-indigo-100 text-indigo-700 px-2.5 py-1 rounded-full border border-indigo-200 transition cursor-pointer">
          💡 Promo Asep Kopling
        </button>
        <button onclick="kirimPesanQuick('Bagaimana cara menyalin caption produk?')" class="text-[11px] bg-indigo-50 hover:bg-indigo-100 text-indigo-700 px-2.5 py-1 rounded-full border border-indigo-200 transition cursor-pointer">
          💡 Cara salin caption
        </button>
      </div>
    </div>

    <!-- Typing Indicator -->
    <div id="chatTyping" class="px-4 py-2 bg-slate-100 text-[11px] text-slate-500 italic hidden flex items-center gap-2 border-t border-slate-200">
      <span class="inline-block animate-bounce">🤖</span> LarisBot sedang berpikir dan meracik respons...
    </div>

    <!-- Input Box Chat -->
    <form id="chatForm" onsubmit="kirimPesan(event)" class="p-3 bg-white border-t border-slate-200 flex items-center gap-2">
      <input type="text" id="chatInput" maxlength="500" placeholder="Tanyakan seputar produk atau promosi..." class="flex-1 text-xs px-3 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
      <button type="submit" id="btnKirimChat" class="bg-indigo-600 hover:bg-indigo-700 text-white px-3.5 py-2.5 rounded-xl text-xs font-semibold shadow-xs transition flex items-center gap-1 cursor-pointer disabled:opacity-50">
        <span>Kirim</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
        </svg>
      </button>
    </form>
  </div>

  <footer class="bg-white border-t border-slate-200 mt-12 py-6 text-center text-xs text-slate-500">
    <p>LarisKetik &copy; 2026 - Integrasi Database MySQL, Arsitektur MVC & Google Gemini AI</p>
  </footer>

  <!-- Script AJAX / Fetch CRUD -->
  <script>
    // Menyimpan data produk dalam variabel JS aman (terhindar dari issue escaping kutip & newline di atribut HTML)
    const productsData = <%- JSON.stringify(products) %>;
    const modal = document.getElementById('modalForm');

    function bukaModalTambah() {
      document.getElementById('productForm').reset();
      document.getElementById('formId').value = '';
      document.getElementById('modalTitle').innerText = 'Tambah Produk Baru';
      modal.classList.remove('hidden');
    }

    function bukaModalEdit(id) {
      const item = productsData.find(p => p.id === id);
      if (!item) return;

      document.getElementById('formId').value = item.id;
      document.getElementById('formNamaProduk').value = item.nama_produk;
      document.getElementById('formPemilik').value = item.pemilik;
      document.getElementById('formTargetMedia').value = item.target_media;
      document.getElementById('formHarga').value = item.harga;
      document.getElementById('formKeunggulan').value = item.keunggulan;
      document.getElementById('formCaption').value = item.caption_otomatis;
      document.getElementById('modalTitle').innerText = 'Edit Detail Produk';
      modal.classList.remove('hidden');
    }

    function tutupModal() {
      modal.classList.add('hidden');
    }

    async function simpanData(e) {
      e.preventDefault();
      const id = document.getElementById('formId').value;
      const hargaVal = parseInt(document.getElementById('formHarga').value, 10);

      if (isNaN(hargaVal)) {
        alert('Harga harus berupa angka!');
        return;
      }

      const payload = {
        nama_produk: document.getElementById('formNamaProduk').value.trim(),
        pemilik: document.getElementById('formPemilik').value.trim(),
        target_media: document.getElementById('formTargetMedia').value,
        harga: hargaVal,
        keunggulan: document.getElementById('formKeunggulan').value.trim(),
        caption_otomatis: document.getElementById('formCaption').value.trim()
      };

      const url = id ? `/api/produk/${id}` : '/api/produk';
      const method = id ? 'PUT' : 'POST';

      try {
        const res = await fetch(url, {
          method: method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Gagal: ' + (result.message || 'Terjadi kesalahan sistem'));
        }
      } catch (err) {
        alert('Terjadi kesalahan jaringan.');
      }
    }

    async function hapusProduk(id) {
      if (!confirm('Yakin ingin menghapus produk ini dari database?')) return;
      try {
        const res = await fetch(`/api/produk/${id}`, { method: 'DELETE' });
        const result = await res.json();
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Gagal menghapus: ' + result.message);
        }
      } catch (err) {
        alert('Terjadi kesalahan jaringan saat menghapus data.');
      }
    }

    function salinTeks(elementId, btnElement) {
      const text = document.getElementById(elementId).innerText;
      navigator.clipboard.writeText(text).then(() => {
        const oldContent = btnElement.innerHTML;
        btnElement.classList.add('bg-emerald-100', 'text-emerald-700');
        btnElement.innerHTML = `<span>✓ Tersalin!</span>`;
        setTimeout(() => {
          btnElement.innerHTML = oldContent;
          btnElement.classList.remove('bg-emerald-100', 'text-emerald-700');
        }, 2000);
      });
    }

    // ==========================================
    // LOGIKA FITUR AI ASSISTANT & GENERATOR
    // ==========================================

    const chatWindow = document.getElementById('chatWindow');
    const chatMessages = document.getElementById('chatMessages');
    const chatInput = document.getElementById('chatInput');
    const chatTyping = document.getElementById('chatTyping');
    const btnKirimChat = document.getElementById('btnKirimChat');

    function toggleChatWindow() {
      chatWindow.classList.toggle('hidden');
      if (!chatWindow.classList.contains('hidden')) {
        chatInput.focus();
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }
    }

    function tambahPesanChat(sender, text) {
      const isUser = sender === 'user';
      const wrapper = document.createElement('div');
      wrapper.className = `flex items-start gap-2 ${isUser ? 'justify-end' : 'justify-start'}`;

      const avatar = document.createElement('div');
      avatar.className = `w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs shrink-0 ${
        isUser ? 'bg-indigo-600 text-white order-2' : 'bg-indigo-100 text-indigo-700 order-1'
      }`;
      avatar.innerText = isUser ? '👤' : '🤖';

      const bubble = document.createElement('div');
      bubble.className = `p-3 rounded-2xl shadow-xs text-xs leading-relaxed max-w-[85%] whitespace-pre-line ${
        isUser 
          ? 'bg-indigo-600 text-white rounded-tr-none order-1' 
          : 'bg-white border border-slate-200 text-slate-800 rounded-tl-none order-2'
      }`;
      bubble.innerText = text;

      wrapper.appendChild(avatar);
      wrapper.appendChild(bubble);
      chatMessages.appendChild(wrapper);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    async function kirimPesan(e) {
      if (e) e.preventDefault();
      const pesan = chatInput.value.trim();
      if (!pesan) return;

      // Sembunyikan quick pills jika ada
      const quickPills = document.getElementById('quickPills');
      if (quickPills) quickPills.style.display = 'none';

      // Tampilkan pesan pengguna di UI
      tambahPesanChat('user', pesan);
      chatInput.value = '';

      // Tampilkan indikator loading
      chatTyping.classList.remove('hidden');
      btnKirimChat.disabled = true;
      chatMessages.scrollTop = chatMessages.scrollHeight;

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: pesan })
        });

        const result = await res.json();
        chatTyping.classList.add('hidden');
        btnKirimChat.disabled = false;

        if (res.ok && result.success) {
          tambahPesanChat('bot', result.data.reply);
        } else {
          tambahPesanChat('bot', '❌ ' + (result.message || 'Terjadi gangguan saat memproses pesan.'));
        }
      } catch (err) {
        chatTyping.classList.add('hidden');
        btnKirimChat.disabled = false;
        tambahPesanChat('bot', '⚠️ Terjadi kesalahan jaringan saat menghubungi server AI.');
      }
    }

    function kirimPesanQuick(text) {
      chatInput.value = text;
      kirimPesan();
    }

    // Generator Caption Otomatis via AI di Form Modal
    async function racikCaptionAI() {
      const nama = document.getElementById('formNamaProduk').value.trim();
      const pemilik = document.getElementById('formPemilik').value.trim();
      const media = document.getElementById('formTargetMedia').value;
      const harga = parseInt(document.getElementById('formHarga').value, 10);
      const keunggulan = document.getElementById('formKeunggulan').value.trim();
      const btnRacik = document.getElementById('btnRacikAI');

      if (!nama || !keunggulan) {
        alert('Mohon isi Nama Produk dan Keunggulan terlebih dahulu agar AI dapat meracik caption dengan tepat!');
        return;
      }

      const hargaFormat = !isNaN(harga) ? `Rp ${harga.toLocaleString('id-ID')}` : 'terjangkau';
      const promptAI = `[MODE GENERATE CAPTION] Tolong racikkan 1 draf caption promosi siap pakai untuk produk baru UMKM berikut:
- Nama Produk: ${nama}
- Pemilik Toko: ${pemilik || 'UMKM'}
- Target Media: ${media}
- Harga: ${hargaFormat}
- Keunggulan: ${keunggulan}

Instruksi: Berikan LANGSUNG isi teks caption promosi lengkap dengan headline, emoji, dan call-to-action yang menarik sesuai target media. Jangan sertakan kata pengantar, basa-basi, atau salam penutup.`;

      btnRacik.disabled = true;
      btnRacik.innerHTML = `<span>⏳ Meracik AI...</span>`;

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: promptAI })
        });

        const result = await res.json();
        btnRacik.disabled = false;
        btnRacik.innerHTML = `<span>✨ Racik Caption via AI</span>`;

        if (res.ok && result.success && result.data && result.data.reply) {
          // Bersihkan jika ada peringatan API key
          if (result.data.isConfigured === false) {
            // Fallback cerdas lokal jika Gemini API Key belum terpasang
            let fallbackCaption = '';
            if (media === 'Status WhatsApp') {
              fallbackCaption = `👋 Halo kak! Lagi cari ${nama}? Sekarang tersedia di ${pemilik || 'toko kami'}! ✨\n\nKeunggulan: ${keunggulan}.\nHarganya cuma ${hargaFormat} aja.\n\nPesan sekarang via WA yuk sebelum kehabisan! 📲✨`;
            } else if (media === 'Instagram / Facebook') {
              fallbackCaption = `🔥 NEW RELEASE: ${nama.toUpperCase()}! 🔥\n\nKenapa harus punya?\n✅ ${keunggulan}\n\n💰 Hanya ${hargaFormat}!\n👉 Klik link di bio untuk order sekarang juga! 🚀\n\n#UMKM #ProdukLokal #PromoSpesial #${nama.replace(/[^a-zA-Z0-9]/g, '')}`;
            } else {
              fallbackCaption = `⚡ SPESIAL HARI INI: ${nama}!\n\n${keunggulan}.\nHarga cuma ${hargaFormat}! Klik keranjang kuning sekarang sebelum kehabisan! 🛍️✨`;
            }
            document.getElementById('formCaption').value = fallbackCaption;
            alert('Catatan: Gemini API Key belum diisi di .env, sistem menggunakan template cerdas LarisKetik.');
          } else {
            document.getElementById('formCaption').value = result.data.reply;
          }
        } else {
          alert('Gagal meracik: ' + (result.message || 'Layanan AI tidak merespons'));
        }
      } catch (err) {
        btnRacik.disabled = false;
        btnRacik.innerHTML = `<span>✨ Racik Caption via AI</span>`;
        alert('Terjadi kesalahan jaringan saat meracik caption.');
      }
    }
  </script>
</body>
</html>