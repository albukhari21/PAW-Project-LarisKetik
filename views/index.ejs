<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">

  <!-- Header & Navbar -->
  <header class="bg-indigo-600 text-white shadow-md sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-3">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">LarisKetik ✍️</h1>
        <p class="text-xs text-indigo-100">Solusi Caption Promosi UMKM Cepat & Tepat</p>
      </div>
      <div class="flex items-center gap-2">
        <a href="/api/status" target="_blank" class="text-xs bg-indigo-700 hover:bg-indigo-800 text-white font-medium py-1.5 px-3 rounded-lg border border-indigo-400 transition">
          Test /api/status ↗
        </a>
        <a href="/api/produk" target="_blank" class="text-xs bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-1.5 px-3 rounded-lg transition shadow-sm">
          Test /api/produk ↗
        </a>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-6xl mx-auto px-4 py-8 flex-1 w-full">
    
    <!-- Hero / Banner Section -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 mb-8">
      <span class="inline-block px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-xs font-semibold mb-3">
        Praktikum Week 7 - Arsitektur MVC Express.js
      </span>
      <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-2">
        Katalog Draf Promosi & Template Takarir
      </h2>
      <p class="text-slate-600 text-sm md:text-base max-w-3xl">
        Data di bawah ini dikirim langsung dari <strong>Model</strong> melalui <strong>Controller</strong> backend Express.js. Pelaku UMKM dapat menyalin draf takarir promosi dalam sekali klik tanpa perlu merangkai kata dari awal.
      </p>
    </div>

    <!-- Product Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% products.forEach(function(item) { %>
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 flex flex-col justify-between hover:shadow-md transition">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700">
                <%= item.targetMedia %>
              </span>
              <span class="text-xs font-bold text-indigo-600">
                Rp <%= item.harga.toLocaleString('id-ID') %>
              </span>
            </div>

            <h3 class="text-lg font-bold text-slate-900 mb-1 leading-snug">
              <%= item.namaProduk %>
            </h3>
            <p class="text-xs font-medium text-slate-500 mb-3">
              Pemilik: <%= item.pemilik %>
            </p>

            <div class="mb-3">
              <p class="text-xs text-slate-400 font-medium uppercase tracking-wider mb-1">Keunggulan:</p>
              <p class="text-xs text-slate-600 bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                <%= item.keunggulan %>
              </p>
            </div>

            <div class="mb-4">
              <p class="text-xs text-slate-400 font-medium uppercase tracking-wider mb-1">Draf Caption Siap Pakai:</p>
              <div id="caption-<%= item.id %>" class="text-xs text-slate-700 bg-amber-50/70 border border-amber-200/60 p-3 rounded-lg leading-relaxed whitespace-pre-line font-mono">
                <%= item.captionOtomatis %>
              </div>
            </div>
          </div>

          <button onclick="salinTeks('caption-<%= item.id %>', this)" class="w-full bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium text-xs py-2.5 px-4 rounded-lg flex items-center justify-center gap-2 transition cursor-pointer shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span>Salin Draf Promosi</span>
          </button>
        </div>
      <% }); %>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-white border-t border-slate-200 mt-12 py-6 text-center text-xs text-slate-500">
    <p>LarisKetik &copy; 2026 - Dikembangkan untuk Pemenuhan Praktikum Arsitektur Web (MVC)</p>
  </footer>

  <!-- Script Copy to Clipboard Toast -->
  <script>
    function salinTeks(elementId, btnElement) {
      const textToCopy = document.getElementById(elementId).innerText;
      navigator.clipboard.writeText(textToCopy).then(() => {
        const originalContent = btnElement.innerHTML;
        btnElement.classList.remove('bg-indigo-600', 'hover:bg-indigo-700');
        btnElement.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
        btnElement.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>Tersalin ke Clipboard!</span>
        `;
        setTimeout(() => {
          btnElement.innerHTML = originalContent;
          btnElement.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
          btnElement.classList.add('bg-indigo-600', 'hover:bg-indigo-700');
        }, 2000);
      }).catch(err => {
        alert('Gagal menyalin teks!');
      });
    }
  </script>
</body>
</html>