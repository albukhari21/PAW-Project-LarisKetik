<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-amber-50/30 text-slate-800 min-h-screen flex flex-col font-sans">

  <%- include('../../partials/adminNav') %>

  <main class="max-w-6xl mx-auto px-4 py-8 flex-1 w-full">
    <!-- Header Page -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
      <div>
        <h1 class="text-2xl font-black text-emerald-950 tracking-tight">Katalog Produk Jamu</h1>
        <p class="text-xs text-slate-500 mt-1">Kelola stok, harga, dan rincian jamu tradisional Seduh Rimba.</p>
      </div>
      <a href="/admin/produk/tambah" class="bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold py-2.5 px-4 rounded-xl shadow-md transition flex items-center gap-2 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>+ Tambah Produk Baru</span>
      </a>
    </div>

    <!-- Alert Notifikasi -->
    <% if (success) { %>
      <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-xs font-medium flex items-center justify-between shadow-xs">
        <div class="flex items-center gap-2">
          <span class="text-base">✓</span>
          <span><%= success %></span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-900 font-bold">&times;</button>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="mb-6 p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-xs font-medium flex items-center justify-between shadow-xs">
        <div class="flex items-center gap-2">
          <span class="text-base">⚠️</span>
          <span><%= error %></span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-rose-600 hover:text-rose-900 font-bold">&times;</button>
      </div>
    <% } %>

    <!-- Filter & Pencarian Bar -->
    <div class="bg-white p-4 rounded-2xl shadow-xs border border-emerald-100 mb-6 flex flex-col sm:flex-row gap-3 items-center justify-between">
      <form action="/admin/produk" method="GET" class="w-full flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <input type="text" name="search" value="<%= search %>" placeholder="Cari nama jamu, komposisi, atau khasiat..." class="w-full pl-9 pr-4 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:bg-white outline-none">
          <span class="absolute left-3 top-2.5 text-slate-400 text-xs">🔍</span>
        </div>

        <select name="kategori_id" onchange="this.form.submit()" class="px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-600 outline-none">
          <option value="">Semua Kategori</option>
          <% categories.forEach(function(kat) { %>
            <option value="<%= kat.id %>" <%= String(kategori_id) === String(kat.id) ? 'selected' : '' %>>
              <%= kat.nama_kategori %>
            </option>
          <% }); %>
        </select>

        <button type="submit" class="px-4 py-2 bg-emerald-800 hover:bg-emerald-900 text-white rounded-xl text-xs font-semibold transition cursor-pointer">
          Terapkan
        </button>

        <% if (search || kategori_id) { %>
          <a href="/admin/produk" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-xs font-semibold text-center transition">
            Reset
          </a>
        <% } %>
      </form>
    </div>

    <!-- Product Table / Card Grid -->
    <% if (products.length === 0) { %>
      <div class="bg-white rounded-2xl border border-dashed border-emerald-200 p-12 text-center shadow-xs">
        <span class="text-4xl block mb-2">🍃</span>
        <h3 class="text-base font-bold text-slate-800">Tidak ada produk jamu yang ditemukan</h3>
        <p class="text-xs text-slate-500 mt-1">Coba sesuaikan kata kunci pencarian atau tambahkan produk baru.</p>
        <a href="/admin/produk/tambah" class="mt-4 inline-block px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold rounded-xl transition">
          + Tambah Produk Sekarang
        </a>
      </div>
    <% } else { %>
      <div class="bg-white rounded-2xl shadow-xs border border-emerald-100 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-700">
            <thead class="bg-emerald-50/70 border-b border-emerald-100 text-emerald-900 uppercase font-bold text-[10px] tracking-wider">
              <tr>
                <th class="py-3 px-4">Produk</th>
                <th class="py-3 px-4">Kategori</th>
                <th class="py-3 px-4">Ukuran</th>
                <th class="py-3 px-4">Harga</th>
                <th class="py-3 px-4 text-center">Stok</th>
                <th class="py-3 px-4 text-center">Status</th>
                <th class="py-3 px-4 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% products.forEach(function(item) { %>
                <tr class="hover:bg-amber-50/30 transition">
                  <!-- Info Produk & Foto -->
                  <td class="py-3.5 px-4">
                    <div class="flex items-center gap-3">
                      <img src="<%= item.foto_url %>" alt="<%= item.nama_produk %>" class="w-12 h-12 rounded-xl object-cover border border-slate-200 shrink-0" onerror="this.src='https://images.unsplash.com/photo-1615485290382-441e4d049cb5?auto=format&fit=crop&w=150&q=80'">
                      <div>
                        <div class="font-bold text-slate-900 flex items-center gap-1.5">
                          <span><%= item.nama_produk %></span>
                          <% if (item.is_unggulan) { %>
                            <span class="px-1.5 py-0.5 bg-amber-100 text-amber-800 font-bold text-[9px] rounded-md">⭐ Unggulan</span>
                          <% } %>
                        </div>
                        <span class="text-[11px] text-slate-400 font-mono">/<%= item.slug %></span>
                      </div>
                    </div>
                  </td>

                  <!-- Kategori -->
                  <td class="py-3.5 px-4 font-medium text-slate-600">
                    <span class="px-2.5 py-1 bg-emerald-50 text-emerald-800 rounded-lg text-[11px] font-semibold border border-emerald-100">
                      <%= item.nama_kategori || 'Umum' %>
                    </span>
                  </td>

                  <!-- Ukuran -->
                  <td class="py-3.5 px-4 text-slate-600 font-medium">
                    <%= item.ukuran %>
                  </td>

                  <!-- Harga -->
                  <td class="py-3.5 px-4 font-bold text-emerald-800">
                    Rp <%= Number(item.harga).toLocaleString('id-ID') %>
                  </td>

                  <!-- Stok -->
                  <td class="py-3.5 px-4 text-center">
                    <% if (item.stok > 10) { %>
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                        <%= item.stok %> btl/pcs
                      </span>
                    <% } else if (item.stok > 0) { %>
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                        <%= item.stok %> (Menipis)
                      </span>
                    <% } else { %>
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800">
                        Habis
                      </span>
                    <% } %>
                  </td>

                  <!-- Status -->
                  <td class="py-3.5 px-4 text-center">
                    <% if (item.status === 'aktif') { %>
                      <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Aktif
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-slate-400">
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span> Nonaktif
                      </span>
                    <% } %>
                  </td>

                  <!-- Tombol Aksi -->
                  <td class="py-3.5 px-4 text-right">
                    <div class="flex items-center justify-end gap-1.5">
                      <a href="/admin/caption?produk_id=<%= item.id %>" title="Buat Caption AI" class="p-1.5 bg-amber-50 hover:bg-amber-100 text-amber-800 rounded-lg transition">
                        ✍️ Caption
                      </a>
                      <a href="/admin/produk/edit/<%= item.id %>" title="Ubah Produk" class="p-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition">
                        ✏️ Edit
                      </a>
                      <form action="/admin/produk/hapus/<%= item.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus produk jamu &quot;<%= item.nama_produk %>&quot;? Data yang dihapus tidak dapat dikembalikan!')" class="inline">
                        <button type="submit" title="Hapus Produk" class="p-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 rounded-lg transition cursor-pointer">
                          🗑️
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </main>

  <footer class="bg-white border-t border-emerald-100 py-5 text-center text-xs text-slate-400">
    <p>Seduh Rimba &copy; 2026 - Panel Manajemen Toko Jamu Tradisional Bu Wati</p>
  </footer>

</body>
</html>
